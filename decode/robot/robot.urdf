
<?xml version="1.0"?>
<robot name="demo_robot">

  <link name="base">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <cylinder radius="0.13" length="0.2"/>
      </geometry>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.07 0.07"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8"
           effort="20" velocity="2"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.065 0.065"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8"
           effort="20" velocity="2"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.06 0.06"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.5 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8"
           effort="20" velocity="2"/>
  </joint>

  <link name="tool_tip">
    <visual>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
    </visual>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="link3"/>
    <child link="tool_tip"/>
    <origin xyz="0.5 0 0"/>
  </joint>

</robot>
